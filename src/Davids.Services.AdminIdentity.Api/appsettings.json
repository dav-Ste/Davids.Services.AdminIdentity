{
  "AllowedHosts": "*",
  "Oidc": {
    "Audience": "davids-admin",
    "BffClientId": "davids-admin-bff",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeHours": 8,
    "AllowedRedirectUris": [
      "https://localhost/signin-oidc",
      "http://localhost:5000/signin-oidc",
      "https://localhost:5001/signin-oidc"
    ],
    "AllowedPostLogoutRedirectUris": [
      "https://localhost/login",
      "http://localhost:5000/login",
      "https://localhost:5001/login"
    ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "WindowSeconds": 60
  },
  "Lockout": {
    "MaxFailedAccessAttempts": 5,
    "DurationMinutes": 15
  },
  "Database": {
    "ApplyMigrations": false
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "Redis": {
    "Enabled": false
  },
  "Vault": {
    "Enabled": false,
    "KvPath": "secret/data/davids/admin-identity"
  }
}
